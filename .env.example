# local = Ollama Gemma on this machine; hosted = DigitalOcean Gemma
MODE=local

# LLM: ollama | digitalocean (defaults from MODE)
LLM_PROVIDER=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:e4b
DO_INFERENCE_BASE_URL=https://inference.do-ai.run/v1
DO_MODEL_ACCESS_KEY=
DO_MODEL=
PROMPT_VERSION=v1

# Places + events
SERPAPI_KEY=

# Data: leave empty to use the on-disk JSON store (data/local_store)
MONGODB_URI=
MONGODB_DB=nobodyplans

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev

# Used to build share links
PUBLIC_URL=http://localhost:5173

# Google Calendar through Auth0 for AI Agents (Token Vault)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Reminder emails (optional): Resend API key + a from address on a verified domain
RESEND_API_KEY=
EMAIL_FROM=
